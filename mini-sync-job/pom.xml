<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minisync</groupId>
        <artifactId>mini-sync</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>mini-sync-job</artifactId>
    <name>mini-sync-job</name>
    <description>任务模块：同步执行器与命令行入口</description>

    <dependencies>
        <dependency>
            <groupId>com.minisync</groupId>
            <artifactId>mini-sync-connector</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>

        <!--
          MySQL / PostgreSQL 插件【同时】作为运行时依赖引入。

          这行不是多此一举：工厂的取值顺序是「plugins 目录优先，classpath 兜底」。
          若 plugins 目录被清空（误删、部署漏拷、镜像层级丢失），
          程序应该仍能跑，而不是直接抛"未实现的数据源类型: MYSQL"。
          把插件 jar 放进 classpath 就得到这条兜底路径，且【不复制任何代码】 ——
          jar 还是同一份，只是同时出现在两个位置。
        -->
        <dependency>
            <groupId>com.minisync</groupId>
            <artifactId>minisync-mysql-plugin</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.minisync</groupId>
            <artifactId>minisync-postgresql-plugin</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!--
              让测试能真正跑起来（默认 surefire 在部分版本下不会自动执行 JUnit5）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>

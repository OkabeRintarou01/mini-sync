<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minisync</groupId>
        <artifactId>mini-sync</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mini-sync-server</artifactId>
    <name>mini-sync-server</name>
    <description>mini-sync 常驻 HTTP 服务（Spring Boot + MyBatis-Plus）</description>

    <dependencies>
        <!-- Web：提供 HTTP 接口与内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（@Valid 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus：管理库的 CRUD 持久层 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!--
          Redis：存放「跨实例共享的临时状态」——
            1. 任务并发锁（防止多实例同时跑同一任务）
            2. 同步运行状态与日志（重启不丢、多实例可读）
            3. 登录会话（重启不掉线、多实例共享）

          注意：数据源配置 / 任务配置 / 执行历史仍走 MySQL，不能放 Redis ——
          那些是持久业务数据，丢了就真丢了。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lettuce 默认不池化，引入 commons-pool2 才会启用连接池 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 管理库驱动（MySQL） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!--
          同步核心。注意 mini-sync-job 会传递依赖 connector / plugin-loader / spi，
          同时它把 mysql / postgresql 插件作为运行时依赖引入（classpath 兜底）。
        -->
        <dependency>
            <groupId>com.minisync</groupId>
            <artifactId>mini-sync-job</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 日志实现 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.minisync.server.MiniSyncServerApplication</mainClass>
                    <!-- 插件 jar 不打进 fat jar，运行时从 plugins/ 目录读 -->
                    <layout>JAR</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

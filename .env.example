# ============================================================
# mini-sync 环境变量示例
#
# 用法：复制本文件为 .env，按实际环境填写（尤其是空着的密码项），
#       然后按下面的方式加载后启动：
#
#   PowerShell (加载到当前进程，不会回显值):
#     Get-Content .env | ForEach-Object {
#       if ($_ -match '^\s*([^#=]+)\s*=\s*(.*)$') {
#         [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#       }
#     }
#     node server.js
#
#   Bash / Git Bash:
#     set -a; source .env; set +a
#     node server.js
#
#   Java 侧同理，JVM 启动前 export 这些变量即可。
#
# 非敏感的本地默认值可保留；两个密码必须自行填写，否则服务/同步会拒绝启动。
# ============================================================

# ---------------- 管理库（MySQL） ----------------
# mini_sync_admin 所在的主机/端口/库名/账号口令
# 密码值留空：请在你自己的未跟踪 .env 中填写，不要提交真实口令
MINISYNC_ADMIN_HOST=127.0.0.1
MINISYNC_ADMIN_PORT=3306
MINISYNC_ADMIN_DB=mini_sync_admin
MINISYNC_DB_USER=root
MINISYNC_DB_PWD=
# 可选：新建 MySQL/PG 数据源时，密码输入框留空会采用该值
MINISYNC_DEFAULT_DS_PWD=

# ---------------- 被同步的业务库 ----------------
# SyncBootstrap / PluginSyncBootstrap 用的 MySQL 源库
MINISYNC_DB_HOST=127.0.0.1
MINISYNC_DB_PORT=3306
MINISYNC_SRC_DB=mini_sync_src

# ---------------- PostgreSQL（Docker 容器） ----------------
MINISYNC_PG_HOST=127.0.0.1
MINISYNC_PG_PORT=5432
MINISYNC_PG_DB=mini_sync_pg
MINISYNC_PG_USER=postgres
MINISYNC_PG_PWD=

# ---------------- 本机工具路径 ----------------
# 按实际安装位置修改
MINISYNC_MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 5.7\bin\mysql.exe
MINISYNC_MVN=D:\apache-maven-3.9.16\bin\mvn.cmd
MINISYNC_JAVA_HOME=D:\jdk

# ---------------- Web 服务端口 ----------------
# Spring Boot 常驻服务的监听端口
MINISYNC_SERVER_PORT=8081

# ---------------- Redis（跨实例共享的临时状态） ----------------
# 管什么：任务并发锁 / 运行进度与日志 / 登录会话
# 不管什么：数据源配置、同步任务、执行历史、增量水位（这些在 MySQL）
#
# true  -> 用 Redis：重启不丢状态、多实例可共享、会话不掉线
# false -> 用内存：单机开发免装 Redis，但重启丢进度、多实例不可见
MINISYNC_REDIS_ENABLED=true

MINISYNC_REDIS_HOST=127.0.0.1
MINISYNC_REDIS_PORT=6379
# 无密码留空
MINISYNC_REDIS_PWD=
MINISYNC_REDIS_DB=0

# 起 Redis（Docker）：
#   docker run -d --name mini-sync-redis -p 6379:6379 redis:7-alpine
#   docker exec mini-sync-redis redis-cli ping    # 应返回 PONG

# ---------------- 插件目录（可选） ----------------
# 不配也能用：服务端会自动定位
#   1. 显式系统属性 -Dminisync.plugin.dir=...
#   2. 当前工作目录下的 plugins/
#   3. 从 class 位置逐级向上找项目根的 plugins/
# 需要放到别处时再打开下面这行，并配合 JVM 参数使用：
# MINISYNC_PLUGIN_DIR=D:\my-drivers
